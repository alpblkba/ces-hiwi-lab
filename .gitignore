# external upstream examples
examples/upstream/
.cleanup-backup/

# -------------------------------------------------------------------
# Xilinx / AMD Vivado, Vitis HLS, Vitis generated files
# -------------------------------------------------------------------

# General Xilinx logs and journals
*.jou
*.log
*.str
*.zip.tmp
hs_err_pid*.log
vivado_pid*.str

# Vivado checkpoints (large, fully regenerable)
*.dcp

# Vivado generated directories
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.runs/
*.gen/
**/*.srcs/sources_1/bd/*/ip/
**/*.srcs/sources_1/bd/*/ipshared/
**/*.srcs/sources_1/bd/*/hw_handoff/
**/*.srcs/sources_1/bd/*/ui/
**/*.srcs/sources_1/bd/*/synth/
**/*.srcs/sources_1/bd/*/sim/

# Vitis / Eclipse workspace metadata
.metadata/
RemoteSystemsTempFiles/
.settings/
.cproject
.project

# Vitis build outputs
Debug/
Release/
*/Debug/
*/Release/
*.elf
*.o
*.d
*.map
*.bif
*.bin
*.bit

# Vitis generated platform/BSP/FSBL output
labs/lab2/task2/vitis/seven_segment_platform/export/
labs/lab2/task2/vitis/seven_segment_platform/ps7_cortexa9_0/
labs/lab2/task2/vitis/seven_segment_platform/zynq_fsbl/

# hw/ holds the exported XSA *plus* Vitis' auto-generated PS7 init
# report/sources (ps7_init.html, ps7_init.c, ps7_init_gpl.c, ...).
# Ignore everything inside it except the one file we actually want.
labs/lab2/task2/vitis/seven_segment_platform/hw/*
!labs/lab2/task2/vitis/seven_segment_platform/hw/seven_segment_wrapper.xsa

!labs/lab2/task2/vitis/seven_segment_platform/platform.spr

# Vitis HLS generated simulation/build internals
labs/lab2/task1/hls/solution1/csim/build/
labs/lab2/task1/hls/solution1/.autopilot/
labs/lab2/task1/hls/solution1/.debug/

# OPTIONAL: raw HLS-generated RTL netlist — duplicated by the packaged
# IP already kept under solution1/impl/ip/hdl/. Keeps the small .rpt
# reports as evidence, drops the large regenerable .vhd/.v copies.
# Delete these two lines if you'd rather keep the raw netlist too.
**/solution1/syn/vhdl/
**/solution1/syn/verilog/

# OS/editor junk
.DS_Store
*.swp
*.swo
*~

# Generated documentation/helper artifacts
README.md.bak
all-docs-preview.md
files.txt
